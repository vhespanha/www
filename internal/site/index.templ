package site

import "go.vhespanha.dev/www/internal/ssg"

templ Index(recent []ssg.Note, more bool) {
	@document("vhespanha") {
		<main class="home">
			@banner()
			<header class="home-name">
				<h1>Vinicius Hespanha</h1>
				<p class="meta">Software Engineer &middot; Brazil</p>
				<div class="home-contact">
					<p class="meta">Open to new roles. If you’re building something interesting, get in touch.</p>
					<p class="meta">
						<a href="mailto:mail@vhespanha.dev">Email</a> &middot;
						<a href="https://github.com/vhespanha">GitHub</a>
					</p>
				</div>
			</header>
			<div class="home-intro">
				<p>
					I build things, usually small and usually from scratch,
					mostly to understand how they work.
				</p>
				<p>
					Lately I’ve been turning operational chaos into systems
					people can rely on. I’d rather build a small, understandable
					tool than a large, clever one.
				</p>
			</div>
			<section class="home-notes">
				<h2>Notes</h2>
				@noteList(recent)
				if more {
					<p><a href="/notes/">All notes</a></p>
				}
			</section>
		</main>
	}
}
